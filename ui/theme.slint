export global JivaroTheme {
    in property <color> background: #0d0f11;
    in property <color> surface: #15181b;
    in property <color> surface-raised: #1d2125;
    in property <color> surface-hover: #282d32;
    in property <color> border: #2d3237;
    in property <color> border-strong: #454b51;
    in property <color> text-primary: #f2f3f1;
    in property <color> text-secondary: #c8cbcb;
    in property <color> text-muted: #a7adb3;
    in property <color> text-disabled: #7a8289;
    in property <color> accent: #d87341;
    in property <color> accent-hover: #e58452;
    in property <color> accent-pressed: #bd5c31;
    in property <color> accent-soft: #4a2b20;
    in property <color> success: #68b989;
    in property <color> success-soft: #1d392b;
    in property <color> warning: #e7b35f;
    in property <color> warning-soft: #3e321d;
    in property <color> danger: #e47c73;
    in property <color> danger-soft: #432521;
}

export component MetaLabel inherits Text {
    color: JivaroTheme.text-muted;
    font-family: "Consolas";
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.2px;
    vertical-alignment: center;
}

export component StatusDot inherits Rectangle {
    in property <color> dot-color: JivaroTheme.accent;

    width: 8px;
    height: 8px;
    border-radius: 4px;
    background: root.dot-color;
}
