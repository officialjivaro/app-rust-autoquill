import { AboutSlint, CheckBox, LineEdit, ListView, Palette, ScrollView, SpinBox } from "std-widgets.slint";
import { JivaroButton, JivaroTextEditor, TokenChip } from "controls.slint";
import { JivaroTheme, MetaLabel, StatusDot } from "theme.slint";

component SettingRange inherits HorizontalLayout {
    in property <string> label;
    in property <bool> field-enabled: true;
    in property <int> minimum: 0;
    in property <int> maximum: 10000;
    in-out property <int> min-value;
    in-out property <int> max-value;

    min-height: 34px;
    max-height: 34px;
    spacing: 7px;
    alignment: center;

    Text {
        text: root.label;
        color: root.field-enabled ? JivaroTheme.text-secondary : JivaroTheme.text-disabled;
        font-family: "Inter";
        font-size: 11px;
        horizontal-stretch: 1;
        overflow: elide;
    }
    SpinBox {
        accessible-label: root.label + " minimum";
        min-width: 76px;
        max-width: 76px;
        minimum: root.minimum;
        maximum: root.maximum;
        value <=> root.min-value;
        enabled: root.field-enabled;
    }
    Text {
        text: "TO";
        color: JivaroTheme.text-muted;
        font-family: "Consolas";
        font-size: 9px;
    }
    SpinBox {
        accessible-label: root.label + " maximum";
        min-width: 76px;
        max-width: 76px;
        minimum: root.minimum;
        maximum: root.maximum;
        value <=> root.max-value;
        enabled: root.field-enabled;
    }
}

component SettingValue inherits HorizontalLayout {
    in property <string> label;
    in property <bool> field-enabled: true;
    in property <int> minimum: 0;
    in property <int> maximum: 86400;
    in-out property <int> value;

    min-height: 34px;
    max-height: 34px;
    spacing: 7px;
    alignment: center;

    Text {
        text: root.label;
        color: root.field-enabled ? JivaroTheme.text-secondary : JivaroTheme.text-disabled;
        font-family: "Inter";
        font-size: 11px;
        horizontal-stretch: 1;
        overflow: elide;
    }
    SpinBox {
        accessible-label: root.label;
        min-width: 96px;
        max-width: 96px;
        minimum: root.minimum;
        maximum: root.maximum;
        value <=> root.value;
        enabled: root.field-enabled;
    }
}

export struct ProfileListItem {
    name: string,
    badge: string,
    detail: string,
}

export component AppWindow inherits Window {
    in property <string> app-version: "0.0.0";
    in property <string> window-title: "AutoQuill";

    in-out property <string> draft-text: "";
    in-out property <int> wpm: 60;
    in-out property <int> character-count: 0;
    in-out property <int> word-count: 0;
    in-out property <bool> can-start: false;
    in-out property <bool> session-active: false;
    in-out property <bool> session-paused: false;
    in-out property <float> simulation-progress: 0;
    in-out property <string> preview-text: "";
    in-out property <string> current-action: "Waiting for text";
    in-out property <string> session-status: "READY";
    in-out property <string> instruction-progress: "0 / 0 ACTIONS";
    in-out property <int> pass-number: 0;
    in-out property <string> elapsed-text: "0.0S ACTIVE";
    in-out property <string> notice-text: "Simulation mode is safe: no keystrokes leave this window.";
    in-out property <bool> notice-is-error: false;
    in-out property <bool> advanced-open: false;
    in-out property <bool> appearance-settings-expanded: true;
    in-out property <bool> session-settings-expanded: true;
    in-out property <bool> humanize-settings-expanded: true;
    in-out property <string> theme-mode: "system";
    in-out property <bool> reduce-motion: false;
    in-out property <ColorScheme> palette-color-scheme <=> Palette.color-scheme;
    in-out property <bool> theme-reduce-motion <=> JivaroTheme.reduce-motion;
    in-out property <bool> real-typing-selected: false;
    in-out property <bool> real-typing-available: false;
    in-out property <bool> real-typing-confirmed: false;
    in-out property <bool> real-typing-confirm-open: false;
    in-out property <string> platform-status: "SIMULATION ONLY";
    in-out property <string> platform-summary: "Real Typing capability has not been detected.";
    in-out property <string> platform-guidance: "Continue with Simulation.";
    in-out property <string> platform-footer: "Simulation is the default every launch • no native input.";
    in-out property <bool> native-behavior-verified: false;
    in-out property <bool> sticky-typing-supported: false;
    in-out property <bool> hotkey-ready: false;
    in-out property <string> hotkey-status: "REGISTERING F1";
    in-out property <string> target-name: "No target captured";
    in-out property <string> target-delivery: "NOT CAPTURED";

    in-out property <bool> profile-manager-open: false;
    in-out property <[ProfileListItem]> profile-items: [];
    in-out property <int> selected-profile-index: -1;
    in-out property <string> current-profile-name: "Unsaved";
    in-out property <bool> profile-modified: false;
    in-out property <string> profile-search: "";
    in-out property <bool> dialog-open: false;
    in-out property <string> dialog-title: "";
    in-out property <string> dialog-message: "";
    in-out property <bool> dialog-input-visible: false;
    in-out property <string> dialog-input: "";
    in-out property <string> dialog-primary-label: "OK";
    in-out property <string> dialog-secondary-label: "";
    in-out property <string> dialog-tertiary-label: "";
    property <bool> overlay-open: root.advanced-open || root.profile-manager-open || root.real-typing-confirm-open || root.dialog-open;

    in-out property <string> shortcut-text: "F1";
    in-out property <bool> shortcut-recording: false;
    in-out property <bool> sticky-typing: false;
    in-out property <bool> startup-delay-enabled: false;
    in-out property <bool> stop-after-enabled: false;
    in-out property <int> stop-after-seconds: 60;
    in-out property <bool> loop-enabled: false;
    in-out property <int> loop-min-seconds: 5;
    in-out property <int> loop-max-seconds: 10;
    in-out property <bool> errors-enabled: false;
    in-out property <int> error-min-interval: 15;
    in-out property <int> error-max-interval: 40;
    in-out property <int> error-min-count: 1;
    in-out property <int> error-max-count: 4;
    in-out property <bool> breaks-enabled: false;
    in-out property <int> break-min-words: 18;
    in-out property <int> break-max-words: 42;
    in-out property <int> break-min-milliseconds: 2000;
    in-out property <int> break-max-milliseconds: 5000;
    in-out property <bool> pauses-enabled: false;
    in-out property <int> pause-min-characters: 120;
    in-out property <int> pause-max-characters: 250;
    in-out property <int> pause-min-milliseconds: 600;
    in-out property <int> pause-max-milliseconds: 1800;

    callback draft-edited(string);
    callback insert-token(string, int, int);
    callback start-simulation();
    callback pause-simulation();
    callback resume-simulation();
    callback stop-simulation();
    callback reset-simulation();
    callback choose-simulation();
    callback request-real-typing();
    callback confirm-real-typing();
    callback cancel-real-typing();
    callback refresh-platform-capabilities();
    callback real-start-help();
    callback shortcut-changed(string);
    callback shortcut-recorded(string, bool, bool, bool, bool);
    callback settings-edited();
    callback open-profile-manager();
    callback profile-search-edited(string);
    callback profile-selected(int);
    callback profile-load();
    callback profile-save();
    callback profile-save-as();
    callback profile-new();
    callback profile-rename();
    callback profile-duplicate();
    callback profile-delete();
    callback profile-default();
    callback profile-import-files();
    callback profile-import-folder();
    callback profile-export();
    callback profile-refresh();
    callback dialog-primary();
    callback dialog-secondary();
    callback dialog-tertiary();
    callback reset-window();
    callback appearance-edited(string, bool);
    callback copy-diagnostics();
    callback export-diagnostics();

    changed wpm => { root.settings-edited(); }
    changed shortcut-text => { root.settings-edited(); root.shortcut-changed(root.shortcut-text); }
    changed sticky-typing => { root.settings-edited(); }
    changed startup-delay-enabled => { root.settings-edited(); }
    changed stop-after-enabled => { root.settings-edited(); }
    changed stop-after-seconds => { root.settings-edited(); }
    changed loop-enabled => { root.settings-edited(); }
    changed loop-min-seconds => { root.settings-edited(); }
    changed loop-max-seconds => { root.settings-edited(); }
    changed errors-enabled => { root.settings-edited(); }
    changed error-min-interval => { root.settings-edited(); }
    changed error-max-interval => { root.settings-edited(); }
    changed error-min-count => { root.settings-edited(); }
    changed error-max-count => { root.settings-edited(); }
    changed breaks-enabled => { root.settings-edited(); }
    changed break-min-words => { root.settings-edited(); }
    changed break-max-words => { root.settings-edited(); }
    changed break-min-milliseconds => { root.settings-edited(); }
    changed break-max-milliseconds => { root.settings-edited(); }
    changed pauses-enabled => { root.settings-edited(); }
    changed pause-min-characters => { root.settings-edited(); }
    changed pause-max-characters => { root.settings-edited(); }
    changed pause-min-milliseconds => { root.settings-edited(); }
    changed pause-max-milliseconds => { root.settings-edited(); }
    changed theme-mode => {
        root.palette-color-scheme = root.theme-mode == "dark" ? ColorScheme.dark : (root.theme-mode == "light" ? ColorScheme.light : ColorScheme.unknown);
        root.appearance-edited(root.theme-mode, root.reduce-motion);
    }
    changed reduce-motion => {
        root.theme-reduce-motion = root.reduce-motion;
        root.appearance-edited(root.theme-mode, root.reduce-motion);
    }
    public function place-editor-caret(offset: int) {
        editor.set-selection-offsets(offset, offset);
        editor.request-editor-focus();
    }

    title: root.window-title;
    icon: @image-url("../assets/icon.png");
    preferred-width: 1280px;
    preferred-height: 720px;
    min-width: 960px;
    min-height: 600px;
    background: JivaroTheme.background;
    forward-focus: app-key-handler;

    app-key-handler := FocusScope {
        width: root.width;
        height: root.height;

        key-pressed(event) => {
            if (root.shortcut-recording) {
                if (event.text == Key.Escape) {
                    root.shortcut-recording = false;
                } else {
                    root.shortcut-recorded(
                        event.text,
                        event.modifiers.control,
                        event.modifiers.alt,
                        event.modifiers.shift,
                        event.modifiers.meta
                    );
                }
                return accept;
            }
            if (event.text == Key.Escape) {
                if (root.dialog-open) {
                    root.dialog-tertiary();
                } else if (root.real-typing-confirm-open) {
                    root.cancel-real-typing();
                } else if (root.profile-manager-open) {
                    root.profile-manager-open = false;
                    profile-launcher.take-focus();
                } else if (root.advanced-open) {
                    root.advanced-open = false;
                    settings-launcher.take-focus();
                }
                return accept;
            }
            return reject;
        }

    workspace-focus := FocusScope {
        width: root.width;
        height: root.height;
        enabled: !root.overlay-open;

    VerticalLayout {
        padding: 18px;
        spacing: 14px;

        header := HorizontalLayout {
            min-height: 50px;
            max-height: 50px;
            spacing: 12px;
            alignment: center;

            logo-shell := Rectangle {
                width: 42px;
                height: 42px;
                border-radius: 12px;
                background: transparent;
                border-width: 1px;
                border-color: JivaroTheme.border-strong;

                Image {
                    x: 6px;
                    y: 6px;
                    width: 30px;
                    height: 30px;
                    source: @image-url("../assets/icon.png");
                    image-fit: contain;
                }
            }

            VerticalLayout {
                spacing: 2px;
                alignment: center;

                Text {
                    text: "AUTOQUILL";
                    color: JivaroTheme.text-primary;
                    font-family: "Inter";
                    font-size: 21px;
                    font-weight: 800;
                    letter-spacing: 0.6px;
                }
                Text {
                    text: "WRITE ONCE. VERIFY EVERY ACTION.";
                    color: JivaroTheme.text-muted;
                    font-family: "Consolas";
                    font-size: 9px;
                    font-weight: 600;
                    letter-spacing: 1px;
                }
            }

            Rectangle { horizontal-stretch: 1; background: transparent; }

            profile-launcher := JivaroButton {
                min-width: 160px;
                max-width: 160px;
                min-height: 40px;
                max-height: 40px;
                label: (root.profile-modified ? "• " : "") + root.current-profile-name;
                enabled: !root.session-active && !root.overlay-open;
                clicked => { root.open-profile-manager(); }
            }

            Rectangle {
                min-width: 172px;
                max-width: 172px;
                height: 40px;
                border-radius: 10px;
                background: root.session-active ? JivaroTheme.accent-soft : JivaroTheme.surface;
                border-width: 1px;
                border-color: root.session-active ? JivaroTheme.accent : JivaroTheme.border;

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 9px;
                    alignment: center;

                    StatusDot {
                        dot-color: root.session-paused ? JivaroTheme.warning : (root.session-active ? JivaroTheme.accent : JivaroTheme.success);
                    }
                    MetaLabel {
                        text: root.session-paused ? "PAUSED SAFELY" : (root.session-active ? (root.real-typing-selected ? "TYPING IN TARGET" : "SIMULATING SAFELY") : (root.real-typing-selected ? "REAL TYPING ARMED" : "INTERACTIVE PREVIEW"));
                    }
                }
            }
        }

        body-clip := Rectangle {
            vertical-stretch: 1;
            background: transparent;
            clip: true;

        body-scroll := ScrollView {
            width: parent.width;
            height: parent.height;
            horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
            vertical-scrollbar-policy: root.width < 1100px ? ScrollBarPolicy.as-needed : ScrollBarPolicy.always-off;
            viewport-width: self.visible-width;
            viewport-height: root.width < 1100px ? 930px : self.visible-height;

            body := GridLayout {
                width: body-scroll.visible-width;
                height: body-scroll.viewport-height;
                spacing: 14px;

            editor-card := Rectangle {
                row: 0;
                col: 0;
                horizontal-stretch: 7;
                vertical-stretch: root.width < 1100px ? 5 : 1;
                border-radius: 16px;
                background: JivaroTheme.surface;
                border-width: 1px;
                border-color: JivaroTheme.border;

                VerticalLayout {
                    padding: 20px;
                    spacing: 11px;

                    HorizontalLayout {
                        min-height: 34px;
                        max-height: 34px;
                        spacing: 10px;
                        alignment: center;
                        VerticalLayout {
                            spacing: 1px;
                            MetaLabel { text: "01 / TEXT TO PREVIEW"; }
                            Text {
                                text: "What should AutoQuill type?";
                                color: JivaroTheme.text-primary;
                                font-family: "Inter";
                                font-size: 21px;
                                font-weight: 750;
                            }
                        }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                        JivaroButton {
                            min-width: 76px;
                            max-width: 76px;
                            min-height: 32px;
                            max-height: 32px;
                            label: "SAVE";
                            enabled: !root.session-active && !root.overlay-open;
                            clicked => { root.profile-save(); }
                        }
                    }

                    HorizontalLayout {
                        min-height: 31px;
                        max-height: 31px;
                        spacing: 8px;
                        alignment: center;

                        Text {
                            text: "INSERT";
                            color: JivaroTheme.text-muted;
                            font-family: "Consolas";
                            font-size: 10px;
                            font-weight: 700;
                        }
                        TokenChip {
                            label: "{CLIPBOARD}";
                            enabled: !root.session-active && !root.overlay-open;
                            clicked => { root.insert-token("{CLIPBOARD}", editor.cursor-byte-offset, editor.anchor-byte-offset); }
                        }
                        TokenChip {
                            label: "{DATE}";
                            enabled: !root.session-active && !root.overlay-open;
                            clicked => { root.insert-token("{DATE}", editor.cursor-byte-offset, editor.anchor-byte-offset); }
                        }
                        TokenChip {
                            label: "{TIME}";
                            enabled: !root.session-active && !root.overlay-open;
                            clicked => { root.insert-token("{TIME}", editor.cursor-byte-offset, editor.anchor-byte-offset); }
                        }
                    }

                    editor := JivaroTextEditor {
                        vertical-stretch: 1;
                        min-height: 200px;
                        text <=> root.draft-text;
                        enabled: !root.session-active && !root.overlay-open;
                        placeholder-text: "Type or paste plain text here…\n\nTry: Hello {DATE}[ENTER]This is a safe preview.";
                        edited(text) => { root.draft-edited(text); }
                    }

                    HorizontalLayout {
                        min-height: 40px;
                        max-height: 40px;
                        spacing: 10px;
                        alignment: center;

                        Text {
                            text: root.character-count + " CHARS  /  " + root.word-count + " WORDS";
                            color: JivaroTheme.text-muted;
                            font-family: "Consolas";
                            font-size: 10px;
                            font-weight: 600;
                        }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                        Text {
                            text: "WPM";
                            color: JivaroTheme.text-muted;
                            font-family: "Consolas";
                            font-size: 10px;
                            font-weight: 700;
                        }
                        SpinBox {
                            accessible-label: "Words per minute";
                            min-width: 92px;
                            max-width: 92px;
                            minimum: 1;
                            maximum: 200;
                            value <=> root.wpm;
                            enabled: !root.session-active && !root.overlay-open;
                        }
                        settings-launcher := JivaroButton {
                            min-width: 92px;
                            max-width: 92px;
                            min-height: 36px;
                            max-height: 36px;
                            label: "SETTINGS";
                            enabled: !root.session-active && !root.overlay-open;
                            clicked => { root.advanced-open = true; }
                        }
                    }
                }
            }

            preview-card := Rectangle {
                row: root.width < 1100px ? 1 : 0;
                col: root.width < 1100px ? 0 : 1;
                horizontal-stretch: 4;
                vertical-stretch: root.width < 1100px ? 4 : 1;
                min-width: root.width < 1100px ? 0px : 340px;
                border-radius: 16px;
                background: JivaroTheme.surface;
                border-width: 1px;
                border-color: root.real-typing-selected ? JivaroTheme.accent : JivaroTheme.border;

                VerticalLayout {
                    padding: 16px;
                    spacing: 8px;

                    mode-selector := Rectangle {
                        min-height: 42px;
                        max-height: 42px;
                        border-radius: 11px;
                        background: JivaroTheme.background;
                        border-width: 1px;
                        border-color: root.real-typing-selected ? JivaroTheme.accent : JivaroTheme.border;

                        HorizontalLayout {
                            padding: 4px;
                            spacing: 5px;
                            JivaroButton {
                                horizontal-stretch: 1;
                                min-height: 34px;
                                max-height: 34px;
                                label: "SIMULATION";
                                primary: !root.real-typing-selected;
                                enabled: !root.session-active && !root.overlay-open;
                                clicked => { root.choose-simulation(); }
                            }
                            real-typing-button := JivaroButton {
                                horizontal-stretch: 1;
                                min-height: 34px;
                                max-height: 34px;
                                label: root.real-typing-available ? "REAL TYPING" : "REAL TYPING • INFO";
                                primary: root.real-typing-selected;
                                enabled: !root.session-active && !root.overlay-open;
                                clicked => { root.request-real-typing(); }
                            }
                        }
                    }

                    Text {
                        min-height: 18px;
                        max-height: 18px;
                        text: root.platform-status + "  •  " + root.platform-summary;
                        color: root.real-typing-available ? JivaroTheme.accent : JivaroTheme.text-muted;
                        font-family: "Consolas";
                        font-size: 9px;
                        font-weight: 650;
                        overflow: elide;
                    }

                    HorizontalLayout {
                        min-height: 18px;
                        max-height: 18px;
                        alignment: center;
                        spacing: 8px;

                        MetaLabel { text: root.real-typing-selected ? "02 / VALIDATION + TARGET" : "02 / VALIDATION PREVIEW"; }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                        Text {
                            text: root.session-status;
                            color: root.notice-is-error ? JivaroTheme.danger : (root.session-paused ? JivaroTheme.warning : (root.session-active ? JivaroTheme.accent : JivaroTheme.success));
                            font-family: "Consolas";
                            font-size: 10px;
                            font-weight: 800;
                        }
                    }

                    Text {
                        text: root.real-typing-selected ? "Verify it, then focus the target." : "See every action before it runs.";
                        color: JivaroTheme.text-primary;
                        font-family: "Inter";
                        font-size: 18px;
                        font-weight: 750;
                    }
                    Text {
                        text: root.real-typing-selected ? (root.session-active ? root.target-delivery + " • " + root.target-name : "Focus the destination, then press " + root.shortcut-text + ".") : "Special keys appear between ‹ › markers.";
                        color: JivaroTheme.text-secondary;
                        font-family: "Inter";
                        font-size: 11px;
                        wrap: word-wrap;
                    }

                    JivaroTextEditor {
                        vertical-stretch: 1;
                        min-height: 90px;
                        text: root.preview-text;
                        read-only: true;
                        enabled: !root.overlay-open;
                        placeholder-text: "Your simulation preview appears here.";
                    }

                    Rectangle {
                        min-height: 42px;
                        max-height: 42px;
                        border-radius: 10px;
                        background: root.session-active ? JivaroTheme.accent-soft : JivaroTheme.background;
                        border-width: 1px;
                        border-color: root.session-paused ? JivaroTheme.warning : (root.session-active ? JivaroTheme.accent : JivaroTheme.border);

                        VerticalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            padding-top: 5px;
                            padding-bottom: 5px;
                            spacing: 2px;

                            MetaLabel { text: "CURRENT ACTION"; }
                            Text {
                                text: root.current-action;
                                color: JivaroTheme.text-primary;
                                font-family: "Inter";
                                font-size: 12px;
                                font-weight: 650;
                                overflow: elide;
                            }
                        }
                    }

                    Rectangle {
                        min-height: 7px;
                        max-height: 7px;
                        border-radius: 4px;
                        background: JivaroTheme.background;
                        clip: true;

                        Rectangle {
                            width: parent.width * root.simulation-progress;
                            height: parent.height;
                            border-radius: parent.border-radius;
                            background: JivaroTheme.accent;
                            animate width { duration: root.reduce-motion ? 0ms : 100ms; easing: ease-out; }
                        }
                    }

                    HorizontalLayout {
                        min-height: 16px;
                        max-height: 16px;
                        spacing: 7px;
                        Text {
                            text: root.instruction-progress;
                            color: JivaroTheme.text-muted;
                            font-family: "Consolas";
                            font-size: 9px;
                            font-weight: 650;
                        }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                        Text {
                            text: (root.pass-number > 0 ? "P" + root.pass-number + "  •  " : "") + root.elapsed-text;
                            color: JivaroTheme.text-muted;
                            font-family: "Consolas";
                            font-size: 9px;
                            font-weight: 650;
                        }
                    }

                    HorizontalLayout {
                        min-height: 40px;
                        max-height: 40px;
                        spacing: 8px;

                        JivaroButton {
                            horizontal-stretch: 1;
                            label: root.session-active ? "STOP" : (root.real-typing-selected ? "FOCUS APP • PRESS " + root.shortcut-text : "START SIMULATION");
                            primary: true;
                            enabled: !root.overlay-open && (root.session-active || (root.can-start && (!root.real-typing-selected || (root.real-typing-confirmed && root.hotkey-ready))));
                            clicked => {
                                if (root.session-active) {
                                    root.stop-simulation();
                                } else if (root.real-typing-selected) {
                                    root.real-start-help();
                                } else {
                                    root.start-simulation();
                                }
                            }
                        }
                        JivaroButton {
                            min-width: 88px;
                            max-width: 88px;
                            label: root.session-active ? (root.session-paused ? "RESUME" : "PAUSE") : "RESET";
                            enabled: !root.overlay-open && (root.session-active || root.preview-text != "");
                            clicked => {
                                if (root.session-paused) {
                                    root.resume-simulation();
                                } else if (root.session-active) {
                                    root.pause-simulation();
                                } else {
                                    root.reset-simulation();
                                }
                            }
                        }
                    }

                    Rectangle {
                        min-height: 42px;
                        max-height: 42px;
                        border-radius: 9px;
                        background: root.notice-is-error ? JivaroTheme.danger-soft : JivaroTheme.success-soft;
                        border-width: 1px;
                        border-color: root.notice-is-error ? JivaroTheme.danger : JivaroTheme.success;

                        Text {
                            x: 10px;
                            y: 7px;
                            width: parent.width - 20px;
                            height: parent.height - 14px;
                            text: root.notice-text;
                            color: root.notice-is-error ? JivaroTheme.danger : JivaroTheme.text-secondary;
                            font-family: "Inter";
                            font-size: 11px;
                            wrap: word-wrap;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
        }
        }

        footer := HorizontalLayout {
            min-height: 28px;
            max-height: 28px;
            spacing: 12px;
            alignment: center;
            Text {
                text: root.platform-footer;
                color: JivaroTheme.text-muted;
                font-family: "Inter";
                font-size: 10px;
            }
            Rectangle { horizontal-stretch: 1; background: transparent; }
            Text {
                text: "JIVARO / AUTOQUILL  •  v" + root.app-version;
                color: JivaroTheme.text-muted;
                font-family: "Consolas";
                font-size: 10px;
                font-weight: 600;
            }
        }
    }
    }

    if root.advanced-open && !root.profile-manager-open && !root.real-typing-confirm-open && !root.dialog-open: Rectangle {
        init => { settings-done-top.take-focus(); }
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        background: #08090aaa;

        TouchArea { clicked => { root.advanced-open = false; settings-launcher.take-focus(); } }

        settings-panel := Rectangle {
            width: min(root.width, 480px);
            height: root.height;
            x: root.width - self.width;
            y: 0;
            border-radius: 18px;
            background: JivaroTheme.surface;
            border-width: 1px;
            border-color: JivaroTheme.border-strong;

            TouchArea { }

            VerticalLayout {
                padding: 20px;
                spacing: 12px;

                HorizontalLayout {
                    min-height: 54px;
                    max-height: 54px;
                    spacing: 12px;
                    alignment: center;

                    VerticalLayout {
                        spacing: 2px;
                        Text {
                            text: "PREFERENCES";
                            color: JivaroTheme.text-primary;
                            font-family: "Inter";
                            font-size: 20px;
                            font-weight: 780;
                        }
                        Text {
                            text: "Tune behavior without leaving the workspace.";
                            color: JivaroTheme.text-muted;
                            font-family: "Inter";
                            font-size: 11px;
                        }
                    }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    settings-done-top := JivaroButton {
                        min-width: 74px;
                        max-width: 74px;
                        min-height: 40px;
                        max-height: 40px;
                        label: "DONE";
                        clicked => { root.advanced-open = false; settings-launcher.take-focus(); }
                    }
                }

                settings-scroll := ScrollView {
                    vertical-stretch: 1;
                    horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                    vertical-scrollbar-policy: ScrollBarPolicy.as-needed;
                    viewport-width: self.visible-width;
                    viewport-height: (root.appearance-settings-expanded ? 242px : 50px) + (root.session-settings-expanded ? 430px : 50px) + (root.humanize-settings-expanded ? 430px : 50px) + 24px;

                    settings-content := VerticalLayout {
                        width: settings-scroll.visible-width;
                        height: settings-scroll.viewport-height;
                        spacing: 12px;

                        appearance-settings := Rectangle {
                            min-height: root.appearance-settings-expanded ? 242px : 50px;
                            max-height: self.min-height;
                            border-radius: 12px;
                            background: JivaroTheme.background;
                            border-width: 1px;
                            border-color: root.appearance-settings-expanded ? JivaroTheme.border-strong : JivaroTheme.border;

                            HorizontalLayout {
                                x: 14px;
                                y: 0;
                                width: parent.width - 28px;
                                height: 50px;
                                alignment: center;
                                spacing: 8px;

                                MetaLabel { text: "APPEARANCE + SUPPORT"; }
                                Rectangle { horizontal-stretch: 1; background: transparent; }
                                Text {
                                    text: root.appearance-settings-expanded ? "−" : "+";
                                    color: JivaroTheme.text-primary;
                                    font-family: "Inter";
                                    font-size: 20px;
                                    font-weight: 700;
                                }
                            }
                            appearance-header-focus := FocusScope {
                                width: parent.width;
                                height: 50px;
                                accessible-role: AccessibleRole.button;
                                accessible-label: "Appearance and support";
                                accessible-action-default => {
                                    root.appearance-settings-expanded = !root.appearance-settings-expanded;
                                }
                                key-pressed(event) => {
                                    if (event.text == " " || event.text == "\n") {
                                        root.appearance-settings-expanded = !root.appearance-settings-expanded;
                                        return accept;
                                    }
                                    return reject;
                                }
                            }
                            TouchArea {
                                height: 50px;
                                clicked => {
                                    appearance-header-focus.focus();
                                    root.appearance-settings-expanded = !root.appearance-settings-expanded;
                                }
                            }

                            if root.appearance-settings-expanded: VerticalLayout {
                                x: 14px;
                                y: 56px;
                                width: parent.width - 28px;
                                height: parent.height - 70px;
                                spacing: 9px;

                                Text {
                                    text: "System follows your desktop. Diagnostics never include typed or clipboard content.";
                                    color: JivaroTheme.text-muted;
                                    font-family: "Inter";
                                    font-size: 11px;
                                    wrap: word-wrap;
                                }
                                HorizontalLayout {
                                    min-height: 38px;
                                    max-height: 38px;
                                    spacing: 7px;
                                    JivaroButton {
                                        horizontal-stretch: 1;
                                        min-height: 36px;
                                        max-height: 36px;
                                        label: "SYSTEM";
                                        primary: root.theme-mode == "system";
                                        clicked => { root.theme-mode = "system"; }
                                    }
                                    JivaroButton {
                                        horizontal-stretch: 1;
                                        min-height: 36px;
                                        max-height: 36px;
                                        label: "DARK";
                                        primary: root.theme-mode == "dark";
                                        clicked => { root.theme-mode = "dark"; }
                                    }
                                    JivaroButton {
                                        horizontal-stretch: 1;
                                        min-height: 36px;
                                        max-height: 36px;
                                        label: "LIGHT";
                                        primary: root.theme-mode == "light";
                                        clicked => { root.theme-mode = "light"; }
                                    }
                                }
                                CheckBox {
                                    text: "Reduce interface motion";
                                    checked <=> root.reduce-motion;
                                }
                                HorizontalLayout {
                                    min-height: 38px;
                                    max-height: 38px;
                                    spacing: 7px;
                                    JivaroButton {
                                        horizontal-stretch: 1;
                                        min-height: 36px;
                                        max-height: 36px;
                                        label: "COPY DIAGNOSTICS";
                                        clicked => { root.copy-diagnostics(); }
                                    }
                                    JivaroButton {
                                        horizontal-stretch: 1;
                                        min-height: 36px;
                                        max-height: 36px;
                                        label: "EXPORT DIAGNOSTICS";
                                        clicked => { root.export-diagnostics(); }
                                    }
                                }
                            }
                        }

                        session-settings := Rectangle {
                            min-height: root.session-settings-expanded ? 430px : 50px;
                            max-height: self.min-height;
                            border-radius: 12px;
                            background: JivaroTheme.background;
                            border-width: 1px;
                            border-color: root.session-settings-expanded ? JivaroTheme.border-strong : JivaroTheme.border;

                            HorizontalLayout {
                                x: 14px;
                                y: 0;
                                width: parent.width - 28px;
                                height: 50px;
                                alignment: center;
                                spacing: 8px;

                                MetaLabel { text: "TIMING + SESSION"; }
                                Rectangle { horizontal-stretch: 1; background: transparent; }
                                Text {
                                    text: root.session-settings-expanded ? "−" : "+";
                                    color: JivaroTheme.text-primary;
                                    font-family: "Inter";
                                    font-size: 20px;
                                    font-weight: 700;
                                }
                            }
                            session-header-focus := FocusScope {
                                width: parent.width;
                                height: 50px;
                                accessible-role: AccessibleRole.button;
                                accessible-label: "Timing and session settings";
                                accessible-action-default => {
                                    root.session-settings-expanded = !root.session-settings-expanded;
                                }
                                key-pressed(event) => {
                                    if (event.text == " " || event.text == "\n") {
                                        root.session-settings-expanded = !root.session-settings-expanded;
                                        return accept;
                                    }
                                    return reject;
                                }
                            }
                            TouchArea {
                                height: 50px;
                                clicked => {
                                    session-header-focus.focus();
                                    root.session-settings-expanded = !root.session-settings-expanded;
                                }
                            }

                            if root.session-settings-expanded: VerticalLayout {
                                x: 14px;
                                y: 56px;
                                width: parent.width - 28px;
                                height: parent.height - 70px;
                                spacing: 7px;

                                Text {
                                    text: "Control activation, duration, repeat behavior, and target intent.";
                                    color: JivaroTheme.text-muted;
                                    font-family: "Inter";
                                    font-size: 11px;
                                    wrap: word-wrap;
                                }
                                HorizontalLayout {
                                    min-height: 40px;
                                    max-height: 40px;
                                    spacing: 9px;
                                    alignment: center;

                                    Text {
                                        text: "Start / stop shortcut";
                                        color: JivaroTheme.text-secondary;
                                        font-family: "Inter";
                                        font-size: 11px;
                                        horizontal-stretch: 1;
                                    }
                                    JivaroButton {
                                        min-width: 190px;
                                        max-width: 190px;
                                        min-height: 36px;
                                        max-height: 36px;
                                        label: root.shortcut-recording ? "PRESS SHORTCUT…" : root.shortcut-text;
                                        enabled: !root.session-active;
                                        clicked => {
                                            root.shortcut-recording = true;
                                            app-key-handler.focus();
                                        }
                                    }
                                }
                                CheckBox {
                                    text: root.sticky-typing-supported ? "Sticky Auto (safe native controls only)" : "Sticky Auto (not available on this platform)";
                                    checked <=> root.sticky-typing;
                                    enabled: root.sticky-typing-supported;
                                }
                                CheckBox {
                                    text: "2-second startup delay";
                                    checked <=> root.startup-delay-enabled;
                                }
                                CheckBox {
                                    text: "Stop after active time";
                                    checked <=> root.stop-after-enabled;
                                }
                                SettingValue {
                                    label: "Active seconds";
                                    field-enabled: root.stop-after-enabled;
                                    minimum: 1;
                                    maximum: 86400;
                                    value <=> root.stop-after-seconds;
                                }
                                CheckBox {
                                    text: "Repeat until stopped";
                                    checked <=> root.loop-enabled;
                                }
                                SettingRange {
                                    label: "Wait seconds";
                                    field-enabled: root.loop-enabled;
                                    minimum: 1;
                                    maximum: 86400;
                                    min-value <=> root.loop-min-seconds;
                                    max-value <=> root.loop-max-seconds;
                                }

                                Rectangle {
                                    min-height: 64px;
                                    max-height: 64px;
                                    border-radius: 9px;
                                    background: JivaroTheme.accent-soft;
                                    border-width: 1px;
                                    border-color: JivaroTheme.accent;
                                    Text {
                                        x: 11px;
                                        y: 8px;
                                        width: parent.width - 22px;
                                        height: parent.height - 16px;
                                        text: root.sticky-typing-supported ? "Sticky Auto uses background delivery only for verified native edit controls and safe documents. Otherwise AutoQuill discloses and uses protected foreground typing." : "This platform is foreground-only. AutoQuill validates the captured application before every operation and stops when it changes.";
                                        color: JivaroTheme.text-secondary;
                                        font-family: "Inter";
                                        font-size: 11px;
                                        wrap: word-wrap;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        humanize-settings := Rectangle {
                            min-height: root.humanize-settings-expanded ? 430px : 50px;
                            max-height: self.min-height;
                            border-radius: 12px;
                            background: JivaroTheme.background;
                            border-width: 1px;
                            border-color: root.humanize-settings-expanded ? JivaroTheme.border-strong : JivaroTheme.border;

                            HorizontalLayout {
                                x: 14px;
                                y: 0;
                                width: parent.width - 28px;
                                height: 50px;
                                alignment: center;
                                spacing: 8px;

                                MetaLabel { text: "NATURAL VARIATION"; }
                                Rectangle { horizontal-stretch: 1; background: transparent; }
                                Text {
                                    text: root.humanize-settings-expanded ? "−" : "+";
                                    color: JivaroTheme.text-primary;
                                    font-family: "Inter";
                                    font-size: 20px;
                                    font-weight: 700;
                                }
                            }
                            humanize-header-focus := FocusScope {
                                width: parent.width;
                                height: 50px;
                                accessible-role: AccessibleRole.button;
                                accessible-label: "Natural variation settings";
                                accessible-action-default => {
                                    root.humanize-settings-expanded = !root.humanize-settings-expanded;
                                }
                                key-pressed(event) => {
                                    if (event.text == " " || event.text == "\n") {
                                        root.humanize-settings-expanded = !root.humanize-settings-expanded;
                                        return accept;
                                    }
                                    return reject;
                                }
                            }
                            TouchArea {
                                height: 50px;
                                clicked => {
                                    humanize-header-focus.focus();
                                    root.humanize-settings-expanded = !root.humanize-settings-expanded;
                                }
                            }

                            if root.humanize-settings-expanded: VerticalLayout {
                                x: 14px;
                                y: 56px;
                                width: parent.width - 28px;
                                height: parent.height - 70px;
                                spacing: 5px;

                                CheckBox {
                                    text: "Simulated mistakes and corrections";
                                    checked <=> root.errors-enabled;
                                }
                                SettingRange {
                                    label: "Action interval";
                                    field-enabled: root.errors-enabled;
                                    minimum: 1;
                                    maximum: 10000;
                                    min-value <=> root.error-min-interval;
                                    max-value <=> root.error-max-interval;
                                }
                                SettingRange {
                                    label: "Mistakes / event";
                                    field-enabled: root.errors-enabled;
                                    minimum: 1;
                                    maximum: 100;
                                    min-value <=> root.error-min-count;
                                    max-value <=> root.error-max-count;
                                }

                                CheckBox {
                                    text: "Longer word-based breaks";
                                    checked <=> root.breaks-enabled;
                                }
                                SettingRange {
                                    label: "Word interval";
                                    field-enabled: root.breaks-enabled;
                                    minimum: 1;
                                    maximum: 500;
                                    min-value <=> root.break-min-words;
                                    max-value <=> root.break-max-words;
                                }
                                SettingRange {
                                    label: "Break ms";
                                    field-enabled: root.breaks-enabled;
                                    minimum: 0;
                                    maximum: 60000;
                                    min-value <=> root.break-min-milliseconds;
                                    max-value <=> root.break-max-milliseconds;
                                }

                                CheckBox {
                                    text: "Short character-based pauses";
                                    checked <=> root.pauses-enabled;
                                }
                                SettingRange {
                                    label: "Character interval";
                                    field-enabled: root.pauses-enabled;
                                    minimum: 1;
                                    maximum: 10000;
                                    min-value <=> root.pause-min-characters;
                                    max-value <=> root.pause-max-characters;
                                }
                                SettingRange {
                                    label: "Pause ms";
                                    field-enabled: root.pauses-enabled;
                                    minimum: 0;
                                    maximum: 60000;
                                    min-value <=> root.pause-min-milliseconds;
                                    max-value <=> root.pause-max-milliseconds;
                                }
                            }
                        }
                    }
                }

                HorizontalLayout {
                    min-height: 42px;
                    max-height: 42px;
                    spacing: 8px;

                    AboutSlint {
                        min-width: 100px;
                        max-width: 100px;
                    }
                    JivaroButton {
                        horizontal-stretch: 1;
                        label: "RESET WINDOW";
                        clicked => { root.reset-window(); }
                    }
                    JivaroButton {
                        min-width: 110px;
                        max-width: 110px;
                        label: "DONE";
                        primary: true;
                        clicked => { root.advanced-open = false; settings-launcher.take-focus(); }
                    }
                }
            }
        }
    }

    if root.profile-manager-open && !root.real-typing-confirm-open && !root.dialog-open: Rectangle {
        init => { profile-search-input.focus(); }
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        background: #08090add;

        TouchArea { clicked => { root.profile-manager-open = false; profile-launcher.take-focus(); } }

        manager-panel := Rectangle {
            width: min(root.width - 40px, 880px);
            height: min(root.height - 40px, 610px);
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            border-radius: 18px;
            background: JivaroTheme.surface;
            border-width: 1px;
            border-color: JivaroTheme.border-strong;

            TouchArea { }

            VerticalLayout {
                padding: 22px;
                spacing: 13px;

                HorizontalLayout {
                    min-height: 50px;
                    max-height: 50px;
                    spacing: 12px;
                    alignment: center;
                    VerticalLayout {
                        spacing: 2px;
                        Text {
                            text: "PROFILES";
                            color: JivaroTheme.text-primary;
                            font-family: "Inter";
                            font-size: 21px;
                            font-weight: 800;
                        }
                        Text {
                            text: "Your text and every setting, kept together.";
                            color: JivaroTheme.text-muted;
                            font-family: "Inter";
                            font-size: 11px;
                        }
                    }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    JivaroButton {
                        label: "REFRESH";
                        min-width: 84px;
                        max-width: 84px;
                        clicked => { root.profile-refresh(); }
                    }
                    JivaroButton {
                        label: "CLOSE";
                        min-width: 76px;
                        max-width: 76px;
                        clicked => { root.profile-manager-open = false; profile-launcher.take-focus(); }
                    }
                }

                HorizontalLayout {
                    min-height: 38px;
                    max-height: 38px;
                    spacing: 9px;
                    profile-search-input := LineEdit {
                        accessible-label: "Search profiles";
                        horizontal-stretch: 1;
                        placeholder-text: "Search profiles";
                        text <=> root.profile-search;
                        edited => { root.profile-search-edited(self.text); }
                    }
                    JivaroButton {
                        label: "NEW";
                        min-width: 74px;
                        max-width: 74px;
                        primary: true;
                        clicked => { root.profile-new(); }
                    }
                    JivaroButton {
                        label: "IMPORT FILES";
                        min-width: 116px;
                        max-width: 116px;
                        clicked => { root.profile-import-files(); }
                    }
                    JivaroButton {
                        label: "IMPORT FOLDER";
                        min-width: 124px;
                        max-width: 124px;
                        clicked => { root.profile-import-folder(); }
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                    min-height: 250px;
                    border-radius: 12px;
                    background: JivaroTheme.background;
                    border-width: 1px;
                    border-color: JivaroTheme.border;
                    clip: true;

                    ListView {
                        x: 8px;
                        y: 8px;
                        width: parent.width - 16px;
                        height: parent.height - 16px;

                        for item[index] in root.profile-items: Rectangle {
                            height: 58px;
                            border-radius: 9px;
                            background: root.selected-profile-index == index ? JivaroTheme.accent-soft : transparent;
                            border-width: root.selected-profile-index == index ? 1px : 0px;
                            border-color: JivaroTheme.accent;

                            HorizontalLayout {
                                padding-left: 13px;
                                padding-right: 13px;
                                spacing: 11px;
                                alignment: center;
                                VerticalLayout {
                                    spacing: 2px;
                                    horizontal-stretch: 1;
                                    Text {
                                        text: item.name;
                                        color: JivaroTheme.text-primary;
                                        font-family: "Inter";
                                        font-size: 13px;
                                        font-weight: 700;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: item.detail;
                                        color: JivaroTheme.text-muted;
                                        font-family: "Inter";
                                        font-size: 10px;
                                        overflow: elide;
                                    }
                                }
                                Rectangle {
                                    min-width: 78px;
                                    max-width: 78px;
                                    min-height: 24px;
                                    max-height: 24px;
                                    border-radius: 7px;
                                    background: item.badge == "CURRENT" ? JivaroTheme.success-soft : JivaroTheme.surface-raised;
                                    border-width: 1px;
                                    border-color: item.badge == "CURRENT" ? JivaroTheme.success : JivaroTheme.border-strong;
                                    Text {
                                        text: item.badge;
                                        color: item.badge == "INVALID" ? JivaroTheme.danger : JivaroTheme.text-secondary;
                                        font-family: "Consolas";
                                        font-size: 9px;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                            TouchArea {
                                clicked => { root.profile-selected(index); }
                                double-clicked => {
                                    root.profile-selected(index);
                                    root.profile-load();
                                }
                            }
                        }
                    }

                    if root.profile-items.length == 0: VerticalLayout {
                        x: 24px;
                        y: (parent.height - self.height) / 2;
                        width: parent.width - 48px;
                        spacing: 7px;
                        Text {
                            text: root.profile-search == "" ? "NO PROFILES YET" : "NO MATCHING PROFILES";
                            color: JivaroTheme.text-primary;
                            font-family: "Inter";
                            font-size: 15px;
                            font-weight: 750;
                            horizontal-alignment: center;
                            accessible-label: self.text;
                        }
                        Text {
                            text: root.profile-search == "" ? "Choose NEW to save this draft as a profile, or import existing AutoQuill JSON files when you are ready." : "Try a different search, clear the field, or import a profile file.";
                            color: JivaroTheme.text-muted;
                            font-family: "Inter";
                            font-size: 11px;
                            wrap: word-wrap;
                            horizontal-alignment: center;
                        }
                    }
                }

                HorizontalLayout {
                    min-height: 38px;
                    max-height: 38px;
                    spacing: 8px;
                    JivaroButton { label: "LOAD"; primary: true; enabled: root.selected-profile-index >= 0; clicked => { root.profile-load(); } }
                    JivaroButton { label: "SAVE"; clicked => { root.profile-save(); } }
                    JivaroButton { label: "SAVE AS"; clicked => { root.profile-save-as(); } }
                    JivaroButton { label: "RENAME"; enabled: root.selected-profile-index >= 0; clicked => { root.profile-rename(); } }
                    JivaroButton { label: "DUPLICATE"; enabled: root.selected-profile-index >= 0; clicked => { root.profile-duplicate(); } }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                }
                HorizontalLayout {
                    min-height: 38px;
                    max-height: 38px;
                    spacing: 8px;
                    JivaroButton { label: "SET DEFAULT"; enabled: root.selected-profile-index >= 0; clicked => { root.profile-default(); } }
                    JivaroButton { label: "EXPORT"; enabled: root.selected-profile-index >= 0; clicked => { root.profile-export(); } }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    JivaroButton { label: "MOVE TO TRASH"; min-width: 130px; enabled: root.selected-profile-index >= 0; clicked => { root.profile-delete(); } }
                }
            }
        }
    }

    if root.real-typing-confirm-open && !root.dialog-open: Rectangle {
        init => { keep-simulation-button.take-focus(); }
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        background: #08090aeb;

        confirm-panel := Rectangle {
            width: min(root.width - 48px, 560px);
            min-height: 380px;
            max-height: 380px;
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            border-radius: 18px;
            background: JivaroTheme.surface;
            border-width: 1px;
            border-color: JivaroTheme.accent;

            VerticalLayout {
                padding: 24px;
                spacing: 15px;

                MetaLabel { text: root.platform-status; }
                Text {
                    text: root.real-typing-available ? "ENABLE REAL TYPING?" : "REAL TYPING STATUS";
                    color: JivaroTheme.text-primary;
                    font-family: "Inter";
                    font-size: 22px;
                    font-weight: 820;
                }
                Text {
                    text: root.platform-summary + " " + root.platform-guidance;
                    color: JivaroTheme.text-secondary;
                    font-family: "Inter";
                    font-size: 12px;
                    wrap: word-wrap;
                }
                Rectangle {
                    min-height: 88px;
                    max-height: 88px;
                    border-radius: 10px;
                    background: JivaroTheme.accent-soft;
                    border-width: 1px;
                    border-color: JivaroTheme.accent;
                    Text {
                        x: 12px;
                        y: 9px;
                        width: parent.width - 24px;
                        height: parent.height - 18px;
                        text: root.native-behavior-verified ? "Before starting: preview the document, place the destination cursor carefully, and close sensitive fields. Press " + root.shortcut-text + " again or press Escape to stop immediately." : "UNVERIFIED EXPERIMENT: logical and native-runner checks cannot prove real desktop input behavior. Use only in a disposable document. Do not use sensitive fields or important data.";
                        color: JivaroTheme.text-secondary;
                        font-family: "Inter";
                        font-size: 11px;
                        wrap: word-wrap;
                        vertical-alignment: center;
                    }
                }
                Rectangle { vertical-stretch: 1; background: transparent; }
                HorizontalLayout {
                    min-height: 40px;
                    max-height: 40px;
                    spacing: 9px;
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    keep-simulation-button := JivaroButton {
                        min-width: 110px;
                        label: "KEEP SIMULATION";
                        clicked => { root.cancel-real-typing(); real-typing-button.take-focus(); }
                    }
                    JivaroButton {
                        min-width: 164px;
                        label: root.real-typing-available ? "I UNDERSTAND • ENABLE" : "RE-CHECK";
                        primary: true;
                        clicked => {
                            if (root.real-typing-available) {
                                root.confirm-real-typing();
                            } else {
                                root.refresh-platform-capabilities();
                            }
                        }
                    }
                }
            }
        }
    }

    if root.dialog-open: Rectangle {
        init => { dialog-primary-button.take-focus(); }
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        background: #08090ae6;

        dialog-panel := Rectangle {
            width: min(root.width - 48px, 520px);
            min-height: root.dialog-input-visible ? 252px : 220px;
            max-height: self.min-height;
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            border-radius: 17px;
            background: JivaroTheme.surface;
            border-width: 1px;
            border-color: JivaroTheme.border-strong;

            VerticalLayout {
                padding: 22px;
                spacing: 14px;
                Text {
                    text: root.dialog-title;
                    color: JivaroTheme.text-primary;
                    font-family: "Inter";
                    font-size: 19px;
                    font-weight: 800;
                }
                Text {
                    text: root.dialog-message;
                    color: JivaroTheme.text-secondary;
                    font-family: "Inter";
                    font-size: 12px;
                    wrap: word-wrap;
                    vertical-stretch: 1;
                }
                if root.dialog-input-visible: LineEdit {
                    accessible-label: "Profile name";
                    text <=> root.dialog-input;
                    placeholder-text: "Profile name";
                }
                HorizontalLayout {
                    min-height: 38px;
                    max-height: 38px;
                    spacing: 8px;
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    JivaroButton {
                        visible: root.dialog-tertiary-label != "";
                        label: root.dialog-tertiary-label;
                        clicked => { root.dialog-tertiary(); }
                    }
                    JivaroButton {
                        visible: root.dialog-secondary-label != "";
                        label: root.dialog-secondary-label;
                        clicked => { root.dialog-secondary(); }
                    }
                    dialog-primary-button := JivaroButton {
                        label: root.dialog-primary-label;
                        primary: true;
                        clicked => { root.dialog-primary(); }
                    }
                }
            }
        }
    }
}
}

export component AutoQuillTray inherits SystemTrayIcon {
    callback show-window();
    callback toggle-session();
    callback quit-application();

    icon: @image-url("../assets/icon.png");
    tooltip: "AutoQuill — Start / Stop typing";
    title: "";
    clicked => { root.show-window(); }

    Menu {
        MenuItem {
            title: "Show AutoQuill";
            activated => { root.show-window(); }
        }
        MenuItem {
            title: "Start / Stop AutoQuill";
            activated => { root.toggle-session(); }
        }
        MenuSeparator { }
        MenuItem {
            title: "Exit AutoQuill";
            activated => { root.quit-application(); }
        }
    }
}
