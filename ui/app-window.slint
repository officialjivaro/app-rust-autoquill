import { AboutSlint, SpinBox } from "std-widgets.slint";
import { JivaroButton, JivaroTextEditor, TokenChip } from "controls.slint";
import { JivaroTheme, MetaLabel, StatusDot } from "theme.slint";

export component AppWindow inherits Window {
    in property <string> app-version: "0.0.0";
    in property <string> window-title: "AutoQuill";

    in-out property <string> draft-text: "";
    in-out property <int> wpm: 60;
    in-out property <int> character-count: 0;
    in-out property <int> word-count: 0;
    in-out property <bool> can-start: false;
    in-out property <bool> session-active: false;
    in-out property <float> simulation-progress: 0;
    in-out property <string> preview-text: "";
    in-out property <string> current-action: "Waiting for text";
    in-out property <string> session-status: "READY";
    in-out property <string> instruction-progress: "0 / 0 INSTRUCTIONS";
    in-out property <string> notice-text: "Simulation mode is safe: no keystrokes leave this window.";
    in-out property <bool> notice-is-error: false;

    callback draft-edited(string);
    callback insert-token(string, int, int);
    callback start-simulation(string, int);
    callback stop-simulation();

    public function place-editor-caret(offset: int) {
        editor.set-selection-offsets(offset, offset);
        editor.request-editor-focus();
    }

    title: root.window-title;
    icon: @image-url("../assets/icon.png");
    preferred-width: 960px;
    preferred-height: 680px;
    min-width: 780px;
    min-height: 600px;
    background: JivaroTheme.background;

    VerticalLayout {
        padding: 24px;
        spacing: 18px;

        header := HorizontalLayout {
            min-height: 58px;
            max-height: 58px;
            spacing: 14px;
            alignment: center;

            logo-shell := Rectangle {
                width: 48px;
                height: 48px;
                border-radius: 13px;
                background: JivaroTheme.text-primary;
                border-width: 1px;
                border-color: JivaroTheme.border-strong;

                Image {
                    x: 7px;
                    y: 7px;
                    width: 34px;
                    height: 34px;
                    source: @image-url("../assets/icon.png");
                    image-fit: contain;
                }
            }

            VerticalLayout {
                spacing: 2px;
                alignment: center;

                Text {
                    text: "AUTOQUILL";
                    color: JivaroTheme.text-primary;
                    font-family: "Inter";
                    font-size: 23px;
                    font-weight: 800;
                    letter-spacing: 0.6px;
                }

                Text {
                    text: "WRITE IT ONCE. PREVIEW EVERY ACTION.";
                    color: JivaroTheme.text-muted;
                    font-family: "Consolas";
                    font-size: 10px;
                    font-weight: 600;
                    letter-spacing: 1px;
                }
            }

            Rectangle { horizontal-stretch: 1; background: transparent; }

            Rectangle {
                min-width: 184px;
                max-width: 184px;
                height: 36px;
                border-radius: 10px;
                background: root.session-active ? JivaroTheme.accent-soft : JivaroTheme.surface;
                border-width: 1px;
                border-color: root.session-active ? JivaroTheme.accent : JivaroTheme.border;

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 9px;
                    alignment: center;

                    StatusDot { dot-color: root.session-active ? JivaroTheme.accent : JivaroTheme.success; }
                    MetaLabel { text: root.session-active ? "SIMULATING SAFELY" : "INTERACTIVE PREVIEW"; }
                }
            }
        }

        body := HorizontalLayout {
            spacing: 16px;
            vertical-stretch: 1;

            editor-card := Rectangle {
                horizontal-stretch: 7;
                border-radius: 16px;
                background: JivaroTheme.surface;
                border-width: 1px;
                border-color: JivaroTheme.border;

                VerticalLayout {
                    padding: 20px;
                    spacing: 11px;

                    MetaLabel { text: "01 / TEXT TO PREVIEW"; }

                    Text {
                        text: "What should AutoQuill type?";
                        color: JivaroTheme.text-primary;
                        font-family: "Inter";
                        font-size: 23px;
                        font-weight: 750;
                    }

                    HorizontalLayout {
                        min-height: 31px;
                        max-height: 31px;
                        spacing: 8px;
                        alignment: center;

                        Text {
                            text: "INSERT";
                            color: JivaroTheme.text-muted;
                            font-family: "Consolas";
                            font-size: 10px;
                            font-weight: 700;
                        }

                        TokenChip {
                            label: "{CLIPBOARD}";
                            enabled: !root.session-active;
                            clicked => { root.insert-token("{CLIPBOARD}", editor.cursor-byte-offset, editor.anchor-byte-offset); }
                        }
                        TokenChip {
                            label: "{DATE}";
                            enabled: !root.session-active;
                            clicked => { root.insert-token("{DATE}", editor.cursor-byte-offset, editor.anchor-byte-offset); }
                        }
                        TokenChip {
                            label: "{TIME}";
                            enabled: !root.session-active;
                            clicked => { root.insert-token("{TIME}", editor.cursor-byte-offset, editor.anchor-byte-offset); }
                        }
                    }

                    editor := JivaroTextEditor {
                        vertical-stretch: 1;
                        min-height: 210px;
                        text <=> root.draft-text;
                        enabled: !root.session-active;
                        placeholder-text: "Type or paste plain text here…\n\nTry: Hello {DATE}[ENTER]This is a safe preview.";
                        edited(text) => { root.draft-edited(text); }
                    }

                    HorizontalLayout {
                        min-height: 40px;
                        max-height: 40px;
                        spacing: 10px;
                        alignment: center;

                        Text {
                            text: root.character-count + " CHARACTERS  /  " + root.word-count + " WORDS";
                            color: JivaroTheme.text-muted;
                            font-family: "Consolas";
                            font-size: 10px;
                            font-weight: 600;
                        }

                        Rectangle { horizontal-stretch: 1; background: transparent; }

                        Text {
                            text: "WPM";
                            color: JivaroTheme.text-muted;
                            font-family: "Consolas";
                            font-size: 10px;
                            font-weight: 700;
                        }

                        SpinBox {
                            min-width: 112px;
                            max-width: 112px;
                            minimum: 1;
                            maximum: 200;
                            value <=> root.wpm;
                            enabled: !root.session-active;
                        }
                    }
                }
            }

            preview-card := Rectangle {
                horizontal-stretch: 4;
                min-width: 290px;
                border-radius: 16px;
                background: JivaroTheme.surface;
                border-width: 1px;
                border-color: JivaroTheme.border;

                VerticalLayout {
                    padding: 20px;
                    spacing: 11px;

                    HorizontalLayout {
                        min-height: 18px;
                        max-height: 18px;
                        alignment: center;
                        spacing: 8px;

                        MetaLabel { text: "02 / SAFE SIMULATION"; }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                        Text {
                            text: root.session-status;
                            color: root.notice-is-error ? JivaroTheme.danger : (root.session-active ? JivaroTheme.accent : JivaroTheme.success);
                            font-family: "Consolas";
                            font-size: 10px;
                            font-weight: 800;
                        }
                    }

                    Text {
                        text: "See every action first.";
                        color: JivaroTheme.text-primary;
                        font-family: "Inter";
                        font-size: 20px;
                        font-weight: 750;
                    }

                    Text {
                        text: "Characters appear as text. Special keys appear between ‹ › markers.";
                        color: JivaroTheme.text-secondary;
                        font-family: "Inter";
                        font-size: 12px;
                        wrap: word-wrap;
                    }

                    JivaroTextEditor {
                        vertical-stretch: 1;
                        min-height: 150px;
                        text: root.preview-text;
                        read-only: true;
                        placeholder-text: "Your simulation preview appears here.";
                    }

                    Rectangle {
                        min-height: 46px;
                        max-height: 46px;
                        border-radius: 10px;
                        background: root.session-active ? JivaroTheme.accent-soft : JivaroTheme.background;
                        border-width: 1px;
                        border-color: root.session-active ? JivaroTheme.accent : JivaroTheme.border;

                        VerticalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            padding-top: 7px;
                            padding-bottom: 7px;
                            spacing: 2px;

                            MetaLabel { text: "CURRENT ACTION"; }
                            Text {
                                text: root.current-action;
                                color: JivaroTheme.text-primary;
                                font-family: "Inter";
                                font-size: 12px;
                                font-weight: 650;
                                overflow: elide;
                            }
                        }
                    }

                    Rectangle {
                        min-height: 7px;
                        max-height: 7px;
                        border-radius: 4px;
                        background: JivaroTheme.background;
                        clip: true;

                        Rectangle {
                            width: parent.width * root.simulation-progress;
                            height: parent.height;
                            border-radius: parent.border-radius;
                            background: JivaroTheme.accent;
                            animate width { duration: 100ms; easing: ease-out; }
                        }
                    }

                    HorizontalLayout {
                        min-height: 16px;
                        max-height: 16px;
                        Text {
                            text: root.instruction-progress;
                            color: JivaroTheme.text-muted;
                            font-family: "Consolas";
                            font-size: 10px;
                            font-weight: 650;
                        }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                        Text {
                            text: round(root.simulation-progress * 100) + "%";
                            color: JivaroTheme.text-muted;
                            font-family: "Consolas";
                            font-size: 10px;
                            font-weight: 650;
                        }
                    }

                    JivaroButton {
                        label: root.session-active ? "STOP SIMULATION" : "START SIMULATION";
                        primary: true;
                        enabled: root.session-active || root.can-start;
                        clicked => {
                            if (root.session-active) {
                                root.stop-simulation();
                            } else {
                                root.start-simulation(root.draft-text, root.wpm);
                            }
                        }
                    }

                    Rectangle {
                        min-height: 42px;
                        max-height: 42px;
                        border-radius: 9px;
                        background: root.notice-is-error ? JivaroTheme.danger-soft : JivaroTheme.success-soft;
                        border-width: 1px;
                        border-color: root.notice-is-error ? JivaroTheme.danger : JivaroTheme.success;

                        Text {
                            x: 10px;
                            y: 7px;
                            width: parent.width - 20px;
                            height: parent.height - 14px;
                            text: root.notice-text;
                            color: root.notice-is-error ? JivaroTheme.danger : JivaroTheme.text-secondary;
                            font-family: "Inter";
                            font-size: 11px;
                            wrap: word-wrap;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        footer := HorizontalLayout {
            min-height: 40px;
            max-height: 40px;
            spacing: 12px;
            alignment: center;

            AboutSlint {
                min-width: 120px;
                max-width: 120px;
            }

            Text {
                text: "Preview only — global shortcuts and native typing stay disabled.";
                color: JivaroTheme.text-muted;
                font-family: "Inter";
                font-size: 11px;
            }

            Rectangle { horizontal-stretch: 1; background: transparent; }

            Text {
                text: "JIVARO / AUTOQUILL  •  v" + root.app-version;
                color: JivaroTheme.text-muted;
                font-family: "Consolas";
                font-size: 10px;
                font-weight: 600;
            }
        }
    }
}
